# ============================================
# Spot the Fake - Environment Configuration
# ============================================
# Copy this file to .env and fill in your credentials
# cp .env.example .env

# --------------------------------------------
# UNSPLASH API
# Get your keys at: https://unsplash.com/developers
# Free tier: 50 requests/hour
# --------------------------------------------
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# --------------------------------------------
# HUGGING FACE API
# Get your key at: https://huggingface.co/settings/tokens
# Free tier available! Create a token with "Read" permissions
# --------------------------------------------
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

# --------------------------------------------
# HUGGING FACE MODEL
# Default
HUGGINGFACE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Option 2
# HUGGINGFACE_MODEL=runwayml/stable-diffusion-v1-5
# Option 3
# HUGGINGFACE_MODEL=CompVis/stable-diffusion-v1-4

# --------------------------------------------
# WORKFLOW SETTINGS (Optional)
# --------------------------------------------
# Images to process per run (default: 5)
BATCH_SIZE=5

# Output image dimensions in pixels
RESIZE_WIDTH=1280
RESIZE_HEIGHT=720

# JPEG compression quality 1-100 (default: 85)
COMPRESSION_QUALITY=85
