# ============================================
# Spot the Fake - Environment Configuration
# ============================================
# Copy this file to .env and fill in your credentials
# cp .env.example .env

# --------------------------------------------
# UNSPLASH API
# Get your keys at: https://unsplash.com/developers
# Free tier: 50 requests/hour
# --------------------------------------------
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# --------------------------------------------
# OPENAI API
# Get your key at: https://platform.openai.com/api-keys
# Requires access to DALL-E 3 (~$0.04-0.08/image)
# --------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here

# --------------------------------------------
# iLoveIMG API
# Get your keys at: https://www.iloveapi.com/
# Free tier: 250 files/month
# --------------------------------------------
ILOVEIMG_PUBLIC_KEY=your_iloveimg_public_key_here
ILOVEIMG_SECRET_KEY=your_iloveimg_secret_key_here

# --------------------------------------------
# GOOGLE DRIVE FOLDERS
# Get folder IDs from the URL:
# https://drive.google.com/drive/folders/[FOLDER_ID]
#
# Remember to share folders with your service account email!
# --------------------------------------------
# GDRIVE_FOLDER_RAW=your_raw_folder_id
# GDRIVE_FOLDER_TO_REPLICATE=your_to_replicate_folder_id
# GDRIVE_FOLDER_READY=your_ready_folder_id

# Optional: Custom path to service account JSON (default: ./credentials/service-account.json)
# GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# --------------------------------------------
# WORKFLOW SETTINGS (Optional)
# --------------------------------------------
# Images to process per run (default: 5)
BATCH_SIZE=5

# Output image dimensions in pixels
RESIZE_WIDTH=1280
RESIZE_HEIGHT=720

# JPEG compression quality 1-100 (default: 85)
COMPRESSION_QUALITY=85
